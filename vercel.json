{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:dist",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/analyze.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/index.html", "destination": "/app.html" },
    { "source": "/api/account/:action*", "destination": "/api/account?action=:action*" },
    { "source": "/api/sync/:action*", "destination": "/api/sync?action=:action*" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(), microphone=(), payment=(), interest-cohort=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https:; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'" }
      ]
    }
  ]
}
