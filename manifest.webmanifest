{
  "name": "Cofre. Organizador financeiro pessoal",
  "short_name": "Cofre",
  "description": "Controle seus gastos, renda e metas financeiras de forma simples e rápida.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#EFF2F0",
  "theme_color": "#0B6B5C",
  "share_target": {
    "action": "./index.html?compartilhar=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "endereco",
      "files": [
        { "name": "arquivos", "accept": ["application/pdf", ".pdf", "image/*", "text/plain", ".txt", "text/csv", ".csv", "application/x-ofx", ".ofx"] }
      ]
    }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
